---
import Logos from './Logos.astro';
import { habilidades } from '../data/contenido.js';
---
<section id="habilidades" class="contenedor habilidades">
  <div class="rv titulo-seccion cabecera">
    <span class="mini" aria-hidden="true"></span>
    <h2>Habilidades</h2>
    <p>Backend con Node.js y Python, y las herramientas para llevar modelos de IA a algo que se use.</p>
  </div>
  <div class="grilla">
    {habilidades.map((h) => (
      <div class="rv sube tarjeta" style={`border-top-color: ${h.color}`}>
        <span class="icono" style={`background: ${h.fondoIcono}`}><img src={h.icono} alt="" width="32" height="32" /></span>
        <div>
          <p class="mono etiqueta">{h.etiqueta}</p>
          <h3>{h.titulo}</h3>
        </div>
        <p class="texto">{h.texto}</p>
        <Logos items={h.techs} tam={52} centrado />
      </div>
    ))}
  </div>
</section>

<style>
  .habilidades { padding-top: 128px; padding-bottom: 112px; }
  .cabecera { margin-bottom: 56px; }
  .cabecera p { max-width: 560px; font-size: 18px; line-height: 1.6; }
  .grilla { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 20px; }
  .tarjeta {
    background: var(--blanco); border: 1.5px solid var(--borde); border-top: 5px solid; border-radius: 16px;
    padding: 34px; display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center;
  }
  .icono { width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px; }
  .etiqueta { font-size: 13px; }
  h3 { font-weight: 700; font-size: 32px; letter-spacing: -.03em; }
  .texto { font-size: 15px; line-height: 1.55; }
  @media (max-width: 720px) {
    .habilidades { padding-top: 88px; padding-bottom: 88px; }
    .tarjeta { padding: 28px 20px; }
  }
</style>
