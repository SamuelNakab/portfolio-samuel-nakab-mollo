---
import Logos from './Logos.astro';
// Fila de proyecto: captura a un lado y detalle al otro.
// grande = proyecto laboral (título más grande y párrafos de detalle)
const { p, invertido = false, grande = false } = Astro.props;
---
<article class:list={['rv', 'sube', 'proyecto', { invertido, laboral: grande }]}>
  <div class="media">
    <img class="captura" src={p.captura.src} width={p.captura.ancho} height={p.captura.alto} alt={p.captura.alt} loading="lazy" decoding="async" />
  </div>
  <div class="info">
    <p class="mono etiqueta"><span class="punto" style={`background: ${p.color}`} aria-hidden="true"></span>{p.numero} · {p.etiqueta}</p>
    <h3>{p.titulo}</h3>
    <p class="resumen">{p.resumen}</p>
    {p.detalles && (
      <div class="detalles">
        {p.detalles.map(([k, v]) => <p><b>{k}:</b> {v}</p>)}
      </div>
    )}
    {p.puntos && <ul>{p.puntos.map((x) => <li>{x}</li>)}</ul>}
    <Logos items={p.techs} tam={grande ? 46 : 42} />
    {p.link && (
      <a class="boton boton-chico" href={p.link.url} target="_blank" rel="noopener noreferrer">{p.link.texto} ↗</a>
    )}
  </div>
</article>

<style>
  .proyecto { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; margin-bottom: 80px; }
  .laboral { margin-bottom: 96px; }
  .invertido { flex-direction: row-reverse; }
  .media { flex: 1 1 440px; min-width: 0; }
  .laboral .media { flex: 1.15 1 520px; }
  .info { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .laboral .info { gap: 18px; }
  .captura {
    display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: left top;
    border-radius: 14px; border: 1px solid var(--borde); box-shadow: 0 24px 50px rgba(var(--tinta-rgb), .14);
  }
  .etiqueta { display: flex; align-items: center; gap: 10px; font-size: 14px; }
  .punto { width: 10px; height: 10px; border-radius: 50%; flex: none; }
  h3 { font-weight: 700; font-size: 44px; line-height: 1; letter-spacing: -.045em; }
  .laboral h3 { font-size: 60px; letter-spacing: -.05em; }
  .resumen { font-size: 17px; line-height: 1.6; }
  .laboral .resumen { font-size: 19px; line-height: 1.55; font-weight: 500; }
  .detalles { display: flex; flex-direction: column; gap: 10px; }
  .detalles p { font-size: 15px; line-height: 1.6; }
  ul { margin: 0; padding-left: 20px; font-size: 15px; line-height: 1.75; }
  @media (max-width: 960px) {
    .invertido { flex-direction: row; }
  }
  @media (max-width: 720px) {
    .proyecto, .laboral { gap: 28px; margin-bottom: 72px; }
    h3 { font-size: 38px; }
    .laboral h3 { font-size: 46px; }
    .boton-chico { word-break: break-all; }
  }
</style>
